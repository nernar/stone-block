<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:orientation="vertical"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	android:background="#FF1B1B1B"
	android:layout_margin="20dp"
	android:padding="10dp">

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="Ваши предпочтения (1/3)"
		android:textSize="19sp"
		android:paddingLeft="15dp"
		android:paddingTop="10dp"
		android:paddingBottom="15dp"/>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:gravity="right">

		<ScrollView
			android:layout_width="wrap_content"
			android:layout_height="match_parent"
			android:layout_weight="1.0">

			<LinearLayout
				android:orientation="vertical"
				android:layout_width="match_parent"
				android:layout_height="match_parent">

				<RadioGroup
					android:orientation="vertical"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="10dp">

					<RadioButton
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Стабильность: плавная игра"/>

					<RadioButton
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Квесты: последовательная игра"/>

					<RadioButton
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Впечатления: и разнообразность"/>

					<CheckBox
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:text="Мультиплеер: игра с друзьями"/>

				</RadioGroup>

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Сборка достаточно тяжелая и требует некоторого количество ресурсов для работы. Мы не ограничиваем вас в выборе вашей хотелки."/>

			</LinearLayout>

		</ScrollView>

		<Button
			android:layout_width="wrap_content"
			style="?android:attr/buttonBarButtonStyle"
			android:layout_height="wrap_content"
			android:text="Продолжить"
			android:enabled="false"
			android:layout_weight="0.1"/>

	</LinearLayout>

</LinearLayout>

