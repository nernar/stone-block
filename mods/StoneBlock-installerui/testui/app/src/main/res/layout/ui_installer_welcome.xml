<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:orientation="vertical"
	android:layout_width="wrap_content"
	android:layout_height="wrap_content"
	android:background="#FF1B1B1B"
	android:layout_margin="20dp"
	android:padding="10dp">

	<TextView
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:text="Средство установки StoneBlock"
		android:textSize="19sp"
		android:paddingTop="10dp"
		android:paddingBottom="15dp"
		android:gravity="center"/>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:orientation="vertical"
		android:gravity="right">

		<ScrollView
			android:layout_width="wrap_content"
			android:layout_height="match_parent"
			android:layout_weight="1.0">

			<LinearLayout
				android:orientation="vertical"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:gravity="center">

				<ImageView
					android:src="@drawable/image_5"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:adjustViewBounds="true"/>

				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Привет! Давай установим StoneBlock на твое устройство. Мы уже начали загружать необходимые файлы для дальнейшей работы сборки."
					android:gravity="center"
					android:textSize="16sp"
					android:paddingLeft="15dp"
					android:paddingRight="15dp"/>

			</LinearLayout>

		</ScrollView>

		<Button
			android:layout_width="wrap_content"
			style="?android:attr/buttonBarButtonStyle"
			android:layout_height="wrap_content"
			android:text="Начнем"
			android:enabled="false"
			android:layout_weight="0.1"/>

	</LinearLayout>

</LinearLayout>

